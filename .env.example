# URL del backend (en Vercel apunta a tu backend de Railway)
VITE_API_URL=http://localhost:4000/api

# Google reCAPTCHA v3 - Site Key (la "llave del sitio")
VITE_RECAPTCHA_SITE_KEY=TU_RECAPTCHA_SITE_KEY_AQUI

# Google OAuth - Client ID
VITE_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_AQUI.apps.googleusercontent.com

# Stripe - Publishable Key (clave pública, segura de exponer)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_TU_STRIPE_PUBLISHABLE_KEY

# En producción (Vercel): VITE_API_URL=https://tu-backend.railway.app/api
# En producción (Vercel): VITE_GOOGLE_CLIENT_ID=tu-client-id-real.apps.googleusercontent.com
# En producción (Vercel): VITE_RECAPTCHA_SITE_KEY=tu-recaptcha-site-key
# En producción (Vercel): VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
